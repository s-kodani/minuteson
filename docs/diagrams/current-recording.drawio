0.5;entryX=1;entryY=0.5;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="os" value="OS側" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="20" y="680" width="280" height="510" /></mxCell><mxCell id="audioOS" value="&lt;b&gt;音声サービス / HAL&lt;/b&gt;&lt;br&gt;マイクPCM&lt;br&gt;他アプリの再生PCM&lt;br&gt;USB・Bluetooth等の経路" vertex="1" parent="os" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="80" width="240" height="140" /></mxCell><mxCell id="permissions" value="&lt;b&gt;権限・経路変更 → 【A】&lt;/b&gt;&lt;br&gt;マイク・再生音声の取得許可&lt;br&gt;入力・出力デバイスの構成" vertex="1" parent="os" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="250" width="240" height="100" /></mxCell><mxCell id="fsOS" value="&lt;b&gt;OSファイルシステム&lt;/b&gt;&lt;br&gt;共有ファイル・音声・SQLite&lt;br&gt;write / fsync / atomic更新" vertex="1" parent="os" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="380" width="240" height="100" /></mxCell><mxCell id="app-audio" value="アプリ側｜音声 → 保存 → 状態確定（左 → 右）" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="330" y="680" width="1550" height="380" /></mxCell><mxCell id="capture" value="P2：録音ヘルパー" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="350" y="735" width="240" height="180" /></mxCell><mxCell id="nativePcm" value="&lt;b&gt;取得・変換・同期保存&lt;/b&gt;&lt;br&gt;macOS：Swift（図2）&lt;br&gt;Windows：C++（図3）" vertex="1" parent="capture" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="116" /></mxCell><mxCell id="raw" value="&lt;b&gt;録音中の確定済み音声&lt;/b&gt;&lt;br&gt;分割CAF（入力別・約4秒）&lt;br&gt;時計・hash・entry / tip" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="660" y="785" width="240" height="120" /></mxCell><mxCell id="save-owner" value="P1：mon-desktop 【B】" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="970" y="735" width="240" height="180" /></mxCell><mxCell id="finalize" value="&lt;b&gt;T：同じ監視スレッド&lt;/b&gt;&lt;br&gt;save_closed&lt;br&gt;CAF検証 → FLAC / WAV&lt;br&gt;中断時も確定範囲を救出" vertex="1" parent="save-owner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="116" /></mxCell><mxCell id="canonical" value="&lt;b&gt;停止後の正式音声&lt;/b&gt;&lt;br&gt;入力別の可逆FLAC&lt;br&gt;会議共通WAV（再生・解析）" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF7F0;strokeColor=#6A9677;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1280" y="785" width="240" height="120" /></mxCell><mxCell id="db" value="&lt;b&gt;SQLite・会議状態&lt;/b&gt;&lt;br&gt;正式WAVまで検証して完了&lt;br&gt;後続の自動解析へ引渡し" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1590" y="785" width="240" height="120" /></mxCell><mxCell id="failure" value="&lt;b&gt;保存失敗&lt;/b&gt;&lt;br&gt;元音声を保持し、再試行へ" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FDEEEE;strokeColor=#BD726A;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="970" y="960" width="240" height="65" /></mxCell><mxCell id="e17" source="audioOS" target="nativePcm" value="PCM・時計" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e07" source="nativePcm" target="raw" value="同期保存" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" source="raw" target="finalize" value="検証・読取" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" source="finalize" target="canonical" value="正式音声" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" source="canonical" target="db" value="P1が登録" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e14" source="finalize" target="failure" value="確定不能" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#BC6F68;strokeColor=#BC6F68;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="legend" value="&lt;b&gt;線の読み方&lt;/b&gt;　青＝PCM　紫＝保存・読取　灰色破線＝制御・状態　赤＝保存失敗。長い折返し線は【A】【B】の対応欄へ分離。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="350" y="1090" width="1490" height="40" /></mxCell><mxCell id="webnote" value="各P1枠は同じ本体プロセス、各P2枠は同じ録音ヘルパー。WebViewの実プロセス構成はOS側が管理。音声・共有ファイル・SQLiteの実体はOSのファイルシステム上。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="350" y="1140" width="1490" height="45" /></mxCell><mxCell id="sources" value="根拠（app/src-tauri/src/ 配下）：lib.rs:2706 / recorder.rs:630,720,844,1516 / recording_recovery.rs:98 / storage/recordings.rs:395,685。文字起こし内部は範囲外。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1220" width="1840" height="45" /></mxCell></root></mxGraphModel></diagram><diagram id="recording-runtime-2" name="02 macOS スレッド・キュー"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1470" background="#ffffff" fold="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;2 / macOS：入力ごとの音声経路と実行単位&lt;/b&gt;" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=26;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="15" width="1840" height="42" /></mxCell><mxCell id="subtitle" value="マイクを上段、PC音声を下段へ分離。右へ進むほど保存に近づく。制御・状態参照は【A〜C】の対応欄へ分離。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="65" width="1840" height="40" /></mxCell><mxCell id="macOS" value="OS側｜音声・HAL・権限" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="20" y="130" width="280" height="950" /></mxCell><mxCell id="helper" value="アプリ側 P2｜mon-macos-capture（Swift / ObjC bridge / Rust静的ライブラリ）" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="330" y="130" width="1210" height="950" /></mxCell><mxCell id="osChange" value="&lt;b&gt;OS構成・経路の変化 【B】&lt;/b&gt;&lt;br&gt;Bluetooth / 機器切替&lt;br&gt;権限・形式・生存状態" vertex="1" parent="macOS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="70" width="240" height="135" /></mxCell><mxCell id="control" value="&lt;b&gt;Task：セッション制御 【C】&lt;/b&gt;&lt;br&gt;100 msで保守・親終了を確認&lt;br&gt;マイク3秒未着 → 再取得" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="70" width="240" height="135" /></mxCell><mxCell id="tapControl" value="&lt;b&gt;Q：tap-control 【A】&lt;/b&gt;&lt;br&gt;Tap / Aggregateの&lt;br&gt;開始・停止・解放を直列化" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="330" y="70" width="240" height="135" /></mxCell><mxCell id="tapMonitor" value="&lt;b&gt;Q：tap-monitor 【B】&lt;/b&gt;&lt;br&gt;250 msタイマー&lt;br&gt;対象・形式・生存状態の検査" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="640" y="70" width="240" height="135" /></mxCell><mxCell id="m12" source="osChange" target="control" value="構成通知" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m03" source="control" target="tapControl" value="開始・停止" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m10" source="tapMonitor" target="tapControl" value="異常時stop" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="osMic" value="&lt;b&gt;OS音声入力 / HAL&lt;/b&gt;&lt;br&gt;選択デバイスのPCM&lt;br&gt;マイク権限" vertex="1" parent="macOS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="295" width="240" height="140" /></mxCell><mxCell id="micTap" value="&lt;b&gt;OSコールバック：マイク&lt;/b&gt;&lt;br&gt;AVAudioEngine input tap&lt;br&gt;UID・世代・形式を検査&lt;br&gt;上限付きコピー → enqueue" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="295" width="240" height="140" /></mxCell><mxCell id="rawMic" value="&lt;b&gt;Q：raw-segments × マイク&lt;/b&gt;&lt;br&gt;16 kHz / mono / PCM16&lt;br&gt;逆行補正・全PCM保持&lt;br&gt;推定時刻を記録・約4秒分割" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="640" y="295" width="240" height="140" /></mxCell><mxCell id="mic-direct" value="マイクはrawキューへ直接渡す" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="650" y="440" width="260" height="35" /></mxCell><mxCell id="osTap" value="&lt;b&gt;OS Core Audio Taps&lt;/b&gt;&lt;br&gt;Process Tap&lt;br&gt;非公開Aggregate device&lt;br&gt;再生PCM・host time" vertex="1" parent="macOS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="610" width="240" height="140" /></mxCell><mxCell id="tapIO" value="&lt;b&gt;Q：tap-io&lt;/b&gt;&lt;br&gt;OSのIOProcコールバック&lt;br&gt;借用PCMを返却前にコピー" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="610" width="240" height="140" /></mxCell><mxCell id="tapDelivery" value="&lt;b&gt;Q：tap-delivery 【C】&lt;/b&gt;&lt;br&gt;最大64件で受渡し&lt;br&gt;SystemPCMWriterで世代検査" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="330" y="610" width="240" height="140" /></mxCell><mxCell id="rawPC" value="&lt;b&gt;Q：raw-segments × PC音声&lt;/b&gt;&lt;br&gt;16 kHz / mono / PCM16&lt;br&gt;世代ごとの形式変換・逆行補正&lt;br&gt;推定時刻を記録・約4秒分割" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="640" y="610" width="240" height="140" /></mxCell><mxCell id="commit" value="&lt;b&gt;Q：segment-commits&lt;/b&gt;&lt;br&gt;2レーンで共有・交互に処理&lt;br&gt;CAF・時計・hashを検証&lt;br&gt;fsync後にentry / tipを公開" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="950" y="445" width="240" height="155" /></mxCell><mxCell id="macFiles" value="&lt;b&gt;共有ファイル｜プロセス外&lt;/b&gt;&lt;br&gt;分割CAF・時計・hash・tip&lt;br&gt;manifest / 入力状態・履歴&lt;br&gt;OSファイルシステム上" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1590" y="575" width="240" height="155" /></mxCell><mxCell id="rust-owner" value="アプリ側 P1｜mon-desktop" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="1590" y="820" width="240" height="175" /></mxCell><mxCell id="rustMain" value="&lt;b&gt;ヘルパー終了後に検証&lt;/b&gt;&lt;br&gt;正式FLAC・WAVを確定&lt;br&gt;全体図の【B】へ" vertex="1" parent="rust-owner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="111" /></mxCell><mxCell id="clock" value="&lt;b&gt;両入力に共通適用：時計・接続所有権&lt;/b&gt;&lt;br&gt;host time → 会議時刻。古い接続のPCMは拒否。逆行補正は接続ごとに保持し、推定時刻と元の停止観測を記録。" vertex="1" parent="helper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF7F0;strokeColor=#6A9677;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="820" width="1165" height="95" /></mxCell><mxCell id="m01" source="osMic" target="micTap" value="PCM・時計" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m02" source="control" target="micTap" value="構成・再取得" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m08" source="micTap" target="rawMic" value="enqueue" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m05" source="osTap" target="tapIO" value="IO callback" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m06" source="tapIO" target="tapDelivery" value="owned sample" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m07" source="tapDelivery" target="rawPC" value="enqueue" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m15" source="rawMic" target="commit" value="job" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m16" source="rawPC" target="commit" value="job" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m17" source="commit" target="macFiles" value="write / fsync" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m19" source="macFiles" target="rust-owner" value="終了後に読取" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="control-a" value="&lt;b&gt;【A】tap-control → OS Core Audio Taps&lt;/b&gt;&lt;br&gt;OS APIでProcess TapとAggregateを開始・停止・解放。&lt;br&gt;取得後のPCMは下段の青線を通る。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="40" y="1140" width="560" height="125" /></mxCell><mxCell id="control-b" value="&lt;b&gt;【B】OS構成 → tap-monitor / Task&lt;/b&gt;&lt;br&gt;OS通知とプロパティ検査で変更を検出。&lt;br&gt;実際のstop / rebuildは制御側で直列に行う。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="660" y="1140" width="560" height="125" /></mxCell><mxCell id="control-c" value="&lt;b&gt;【C】状態参照と公開&lt;/b&gt;&lt;br&gt;tap-deliveryの入力状態をTaskへ反映。&lt;br&gt;Taskがmanifest・状態・履歴を共有ファイルへ公開。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1280" y="1140" width="560" height="125" /></mxCell><mxCell id="macLegend" value="&lt;b&gt;凡例&lt;/b&gt; P＝プロセス　Q＝直列GCDキュー　Task＝Swift非同期タスク。Q / Taskは固定のOSスレッド1本を意味しない。青＝PCM、紫＝保存、灰色破線＝隣接する制御。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1300" width="1840" height="45" /></mxCell><mxCell id="macNotes" value="通常録音：無音PCMも受信扱い。installTapのObjC例外はエラーへ変換して再取得。正常停止は両入力のOS停止確認 → 各Q排出 → producerClosed。取得待ち20秒・16MiB・4096件、保存確定待ち最大120秒/入力。上限・保存不能は停止し確定済み音声を保持。全体録音は自身のツリーを除外、アプリ指定は対象ツリーのみ。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1350" width="1840" height="55" /></mxCell><mxCell id="macSources" value="根拠（probes/macos-capture/Sources/MONMacOSCapture/ 配下）：CaptureSession.swift:79,200,239,308 / NativeCoreAudioCaptureDriver.swift:80,131,163 / CoreAudioCaptureStream.swift:22,129 / RawRecordingSegments.swift:106 / RawSegmentCommitWorker.swift:17。ScreenCaptureKit・5秒テスト・単体probe経路は本図の対象外。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1415" width="1840" height="45" /></mxCell></root></mxGraphModel></diagram><diagram id="recording-runtime-3" name="03 Windows スレッド・キュー"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1470" background="#ffffff" fold="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;3 / Windows：取得・変換・保存のスレッドを分けて読む&lt;/b&gt;" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=26;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="15" width="1840" height="42" /></mxCell><mxCell id="subtitle" value="macOSと同じ左 → 右の順序。WASAPI取得 → PacketQueue → メインスレッドで変換 → 保存専用スレッド。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="65" width="1840" height="40" /></mxCell><mxCell id="windowsOS" value="OS側｜音声・機器" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="20" y="130" width="280" height="950" /></mxCell><mxCell id="winHelper" value="アプリ側 P2｜mon-windows-capture.exe（C++ / Rust静的ライブラリ）" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="330" y="130" width="1210" height="950" /></mxCell><mxCell id="winChange" value="&lt;b&gt;OSデバイス・経路変更 【C】&lt;/b&gt;&lt;br&gt;既定出力・機器・セッション&lt;br&gt;変更通知とデバイス一覧" vertex="1" parent="windowsOS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="70" width="240" height="135" /></mxCell><mxCell id="prep" value="&lt;b&gt;T：InputPreparation 【B】&lt;/b&gt;&lt;br&gt;入力選択・COM・接続準備。入力ごとにsingle-flight。&lt;br&gt;待機でメインの制御・PCM処理を止めない。" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="70" width="550" height="135" /></mxCell><mxCell id="sessionThread" value="T：CaptureSessionメイン&lt;br&gt;制御・2入力の変換は同じスレッド" vertex="1" parent="winHelper" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;startSize=70;"><mxGeometry as="geometry" x="610" y="45" width="290" height="720" /></mxCell><mxCell id="winControl" value="&lt;b&gt;制御ループ 【A】&lt;/b&gt;&lt;br&gt;停止・親監視・入力再取得&lt;br&gt;2レーンをpump" vertex="1" parent="sessionThread" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="90" width="250" height="125" /></mxCell><mxCell id="winMetadata" value="&lt;b&gt;T：MetadataWorker&lt;/b&gt;&lt;br&gt;入力状態・level・時計診断&lt;br&gt;manifest・履歴を保存&lt;br&gt;状態生成は250 ms間隔" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="950" y="115" width="240" height="145" /></mxCell><mxCell id="winStateFiles" value="&lt;b&gt;共有ファイル｜状態 【A】&lt;/b&gt;&lt;br&gt;manifest / 入力状態・履歴&lt;br&gt;level / 時計診断&lt;br&gt;停止・マイク選択要求も共用" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1590" y="245" width="240" height="145" /></mxCell><mxCell id="w10" source="winControl" target="prep" value="準備・再取得" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.8;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w13" source="winControl" target="winMetadata" value="状態" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w15" source="winMetadata" target="winStateFiles" value="公開" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#7C8999;strokeColor=#7C8999;strokeWidth=1.6;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=5 4;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="winMicOS" value="&lt;b&gt;OS WASAPI入力&lt;/b&gt;&lt;br&gt;通話用既定入力&lt;br&gt;または固定デバイス&lt;br&gt;音声権限・入力デバイス" vertex="1" parent="windowsOS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="315" width="240" height="140" /></mxCell><mxCell id="micRead" value="&lt;b&gt;T：AsyncCapture（Mic）【B】&lt;/b&gt;&lt;br&gt;GetBuffer / ReleaseBuffer&lt;br&gt;同じ取得スレッドで実行&lt;br&gt;3秒未着 → 停止・再取得" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="315" width="240" height="140" /></mxCell><mxCell id="micQueue" value="&lt;b&gt;PacketQueue：マイク&lt;/b&gt;&lt;br&gt;コピー済みPCM・時刻&lt;br&gt;上限付きメモリキュー" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="330" y="315" width="240" height="140" /></mxCell><mxCell id="micLane" value="&lt;b&gt;マイクLane&lt;/b&gt;&lt;br&gt;時計対応・PCM変換&lt;br&gt;16 kHz / mono / PCM16&lt;br&gt;約4秒分をジョブ化" vertex="1" parent="sessionThread" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="270" width="250" height="140" /></mxCell><mxCell id="winPlayback" value="&lt;b&gt;OS WASAPI再生音声&lt;/b&gt;&lt;br&gt;全体：出力ごとのloopback&lt;br&gt;アプリ指定：process loopback&lt;br&gt;パケット・QPC時刻" vertex="1" parent="windowsOS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F0F2F5;strokeColor=#7F8D9D;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="600" width="240" height="140" /></mxCell><mxCell id="pcRead" value="&lt;b&gt;T：PC音声取得 【B】【C】&lt;/b&gt;&lt;br&gt;全体：SystemCapture&lt;br&gt;出力別loopback・QPC合成&lt;br&gt;アプリ指定：AsyncCapture" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="600" width="240" height="140" /></mxCell><mxCell id="pcQueue" value="&lt;b&gt;PacketQueue：PC音声&lt;/b&gt;&lt;br&gt;全体は合成済みPCM&lt;br&gt;上限付きメモリキュー" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="330" y="600" width="240" height="140" /></mxCell><mxCell id="pcLane" value="&lt;b&gt;PC音声Lane&lt;/b&gt;&lt;br&gt;時計対応・PCM変換&lt;br&gt;16 kHz / mono / PCM16&lt;br&gt;約4秒分をジョブ化" vertex="1" parent="sessionThread" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="555" width="250" height="140" /></mxCell><mxCell id="winCommit" value="&lt;b&gt;T：RawCommitWorker&lt;/b&gt;&lt;br&gt;入力間を交互に処理&lt;br&gt;CAF検証・FlushFileBuffers&lt;br&gt;entry / tipを公開" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="950" y="450" width="240" height="155" /></mxCell><mxCell id="winFiles" value="&lt;b&gt;共有ファイル｜確定音声&lt;/b&gt;&lt;br&gt;分割CAF・時計・hash・tip&lt;br&gt;OSファイルシステム上&lt;br&gt;同期済みの範囲だけ公開" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1590" y="580" width="240" height="155" /></mxCell><mxCell id="winRust-owner" value="アプリ側 P1｜mon-desktop" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="1590" y="825" width="240" height="175" /></mxCell><mxCell id="winRust" value="&lt;b&gt;終了後に読取・検証&lt;/b&gt;&lt;br&gt;Job Objectで子を所有&lt;br&gt;正式FLAC・WAVを確定" vertex="1" parent="winRust-owner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="111" /></mxCell><mxCell id="win-stop" value="&lt;b&gt;停止と上限&lt;/b&gt;&lt;br&gt;両入力停止確認 → PacketQueue・保存ジョブを排出 → producerClosed。&lt;br&gt;上限・不正PCM・保存不能では停止し、確定済み音声を保持する。" vertex="1" parent="winHelper" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF7F0;strokeColor=#6A9677;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="20" y="815" width="1165" height="100" /></mxCell><mxCell id="w03" source="winMicOS" target="micRead" value="PCM" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w06" source="micRead" target="micQueue" value="enqueue" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w08" source="micQueue" target="micLane" value="pump" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w04" source="winPlayback" target="pcRead" value="PCM / QPC" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w07" source="pcRead" target="pcQueue" value="enqueue" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w09" source="pcQueue" target="pcLane" value="pump" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#376E98;strokeColor=#376E98;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w11" source="micLane" target="winCommit" value="job" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w12" source="pcLane" target="winCommit" value="job" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w14" source="winCommit" target="winFiles" value="同期保存" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="w17" source="winFiles" target="winRust-owner" value="終了後に読取" edge="1" parent="1" style="edgeStyle=none;rounded=1;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#896BA8;strokeColor=#896BA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=8;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="win-control-a" value="&lt;b&gt;【A】共有ファイル → メイン制御&lt;/b&gt;&lt;br&gt;stop.request・microphone-selection.requestを読む。&lt;br&gt;状態公開のワーカーとは独立して停止を受け付ける。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="40" y="1140" width="560" height="125" /></mxCell><mxCell id="win-control-b" value="&lt;b&gt;【B】接続準備 → 各取得スレッド&lt;/b&gt;&lt;br&gt;InputPreparationがWASAPI接続を準備。&lt;br&gt;同じ入力の準備完了・破棄を確認してから次を取得。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="660" y="1140" width="560" height="125" /></mxCell><mxCell id="win-control-c" value="&lt;b&gt;【C】OS経路 → PC音声取得&lt;/b&gt;&lt;br&gt;変更通知＋100 ms照合。終了する出力の末尾を排出。&lt;br&gt;継続中の出力は保ち、遅延時計を補正して全PCM保持。" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#FFF4E5;strokeColor=#C28B48;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1280" y="1140" width="560" height="125" /></mxCell><mxCell id="winLegend" value="&lt;b&gt;凡例&lt;/b&gt; P＝プロセス　T＝実際のスレッド（メイン以外はstd::thread）。PacketQueueはメモリで、スレッドではない。青＝PCM、紫＝保存、灰色破線＝隣接する制御。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1300" width="1840" height="45" /></mxCell><mxCell id="winNote1" value="全体録音は既定・再生中の出力を公平に読み出し、250 ms待ちで合成。アプリ指定はprocess loopbackのみ。マイクの無音パケットも受信扱い。PC音声に3秒未着判定を適用しない。取得・保存待ちの上限は共通契約。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1350" width="1840" height="50" /></mxCell><mxCell id="winSources" value="根拠（probes/windows-capture/ 配下）：async_capture.h:14,50 / system_capture.h:17,100 / capture_session.h:36,115,119,220 / input_preparation.h:34,53 / raw_commit_worker.h:25,96 / metadata_worker.h:6,56。5秒テスト・合成試験経路は本図の対象外。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="1415" width="1840" height="45" /></mxCell></root></mxGraphModel></diagram></mxfile>