ed=0;" target="rustMain" value="検証して読取"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="macLegend" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="&lt;b&gt;凡例&lt;/b&gt;　P＝別プロセス　Q＝直列GCDキュー　Task＝Swift非同期タスク（固定スレッドではない）　青＝PCM　紫＝保存　破線＝制御" vertex="1"><mxGeometry height="35" width="1080" x="20" y="990" as="geometry" /></mxCell><mxCell id="macNotes" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="Qは固定のOSスレッド1本を意味しない。AVAudioEngineの通知ではフラグ更新だけを行い、stop / rebuildは制御側で実行。installTapのObjC例外もエラーに変換して再取得する。" vertex="1"><mxGeometry height="42" width="1080" x="20" y="1030" as="geometry" /></mxCell><mxCell id="macNotes2" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="キュー名は app.mon.capture. の接頭辞を省略。raw-segmentsは同名の別インスタンス×2。取得待ち20秒・16MiB・4096件、保存確定待ち最大120秒/入力。上限・保存不能は停止し確定済み音声を保持。全体は自身のプロセスツリーを除外し、アプリ指定時は対象ツリーのみ。" vertex="1"><mxGeometry height="44" width="1080" x="20" y="1076" as="geometry" /></mxCell><mxCell id="macSources" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="根拠（probes/macos-capture/Sources/MONMacOSCapture/ 配下）：CaptureSession.swift:79,200,239,308 / NativeCoreAudioCaptureDriver.swift:80,131,163 / CoreAudioCaptureStream.swift:22,129 / RawRecordingSegments.swift:106 / RawSegmentCommitWorker.swift:17。ScreenCaptureKit・5秒テスト・単体probe経路は本図の対象外。" vertex="1"><mxGeometry height="25" width="1080" x="20" y="1122" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="recording-runtime-3" name="03 Windows スレッド・キュー"><mxGraphModel adaptiveColors="auto" dx="1120" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1124" pageHeight="1179" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=23;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="&lt;b&gt;3 / Windows：録音ヘルパー内の実行単位&lt;/b&gt;" vertex="1"><mxGeometry height="32" width="1080" x="20" y="10" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="同じファイルIPC・保存契約で取得部分をWASAPIへ置換。変換・Lane.pumpはヘルパーのメインスレッド、ディスク保存は別スレッド。" vertex="1"><mxGeometry height="35" width="1080" x="20" y="46" as="geometry" /></mxCell><mxCell id="windowsOS" parent="1" style="swimlane;horizontal=1;startSize=36;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#243247;fillColor=#eff1f4;swimlaneFillColor=#ffffff;strokeColor=#8993a2;strokeWidth=2;spacingLeft=10;strokeWidth=3;" value="OS側：音声・機器" vertex="1"><mxGeometry height="720" width="240" x="20" y="100" as="geometry" /></mxCell><mxCell id="winMicOS" parent="windowsOS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#eff1f4;strokeColor=#8993a2;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;OS WASAPI入力&lt;/b&gt;&lt;br&gt;通話用既定入力&lt;br&gt;または固定デバイス&lt;br&gt;音声権限・入力デバイス" vertex="1"><mxGeometry height="120" width="200" x="20" y="85" as="geometry" /></mxCell><mxCell id="winPlayback" parent="windowsOS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#eff1f4;strokeColor=#8993a2;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;OS WASAPI再生音声&lt;/b&gt;&lt;br&gt;全体：出力ごとのloopback&lt;br&gt;アプリ指定：process loopback&lt;br&gt;パケット・QPC時刻" vertex="1"><mxGeometry height="130" width="200" x="20" y="310" as="geometry" /></mxCell><mxCell id="winChange" parent="windowsOS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#eff1f4;strokeColor=#8993a2;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;OSデバイス・経路変更&lt;/b&gt;&lt;br&gt;既定出力・機器・セッション&lt;br&gt;変更通知＋一覧照合&lt;br&gt;出力経路を追従" vertex="1"><mxGeometry height="120" width="200" x="20" y="540" as="geometry" /></mxCell><mxCell id="winHelper" parent="1" style="swimlane;horizontal=1;startSize=36;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#243247;fillColor=#e9f1fb;swimlaneFillColor=#ffffff;strokeColor=#5b7ea4;strokeWidth=2;spacingLeft=10;strokeWidth=3;" value="P：mon-windows-capture.exe（C++＋Rust静的ライブラリ）" vertex="1"><mxGeometry height="720" width="820" x="280" y="100" as="geometry" /></mxCell><mxCell id="prep" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#fff2e2;strokeColor=#c28a45;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;T：InputPreparation&lt;/b&gt;&lt;br&gt;入力選択・COM・接続の準備&lt;br&gt;入力ごとに同時実行を制限&lt;br&gt;待機で制御ループを止めない" vertex="1"><mxGeometry height="125" width="240" x="20" y="65" as="geometry" /></mxCell><mxCell id="micRead" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#e9f1fb;strokeColor=#5b7ea4;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;T：AsyncCapture（マイク）&lt;/b&gt;&lt;br&gt;GetBuffer / ReleaseBuffer&lt;br&gt;同じ取得スレッド内で実行&lt;br&gt;3秒未着 → 停止・再取得" vertex="1"><mxGeometry height="125" width="220" x="300" y="65" as="geometry" /></mxCell><mxCell id="pcRead" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#e9f1fb;strokeColor=#5b7ea4;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;T：PC音声の取得&lt;/b&gt;&lt;br&gt;全体：SystemCapture&lt;br&gt;出力別loopback・QPC合成&lt;br&gt;アプリ指定：AsyncCapture&lt;br&gt;（方式はいずれか一方）" vertex="1"><mxGeometry height="135" width="240" x="560" y="65" as="geometry" /></mxCell><mxCell id="micQueue" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#f1ecf7;strokeColor=#8d77a6;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;PacketQueue：マイク&lt;/b&gt;&lt;br&gt;コピー済みPCM・時刻&lt;br&gt;上限付きメモリキュー" vertex="1"><mxGeometry height="85" width="220" x="300" y="235" as="geometry" /></mxCell><mxCell id="pcQueue" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#f1ecf7;strokeColor=#8d77a6;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;PacketQueue：PC音声&lt;/b&gt;&lt;br&gt;全体は合成済みPCM&lt;br&gt;上限付きメモリキュー" vertex="1"><mxGeometry height="85" width="240" x="560" y="235" as="geometry" /></mxCell><mxCell id="sessionThread" parent="winHelper" style="swimlane;horizontal=1;startSize=36;collapsible=0;rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#243247;fillColor=#e9f1fb;swimlaneFillColor=#ffffff;strokeColor=#5b7ea4;strokeWidth=2;spacingLeft=10;startSize=52;" value="T：CaptureSessionメイン&lt;br&gt;制御＋2入力の変換は同一スレッド" vertex="1"><mxGeometry height="330" width="500" x="20" y="360" as="geometry" /></mxCell><mxCell id="winControl" parent="sessionThread" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#fff2e2;strokeColor=#c28a45;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;制御ループ&lt;/b&gt;&lt;br&gt;停止・親監視・入力再取得・2レーンをpump" vertex="1"><mxGeometry height="65" width="460" x="20" y="65" as="geometry" /></mxCell><mxCell id="micLane" parent="sessionThread" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#e9f1fb;strokeColor=#5b7ea4;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;マイクLane&lt;/b&gt;&lt;br&gt;時計対応・PCM変換&lt;br&gt;16 kHz / mono / PCM16&lt;br&gt;約4秒分をジョブ化" vertex="1"><mxGeometry height="120" width="215" x="20" y="175" as="geometry" /></mxCell><mxCell id="pcLane" parent="sessionThread" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#e9f1fb;strokeColor=#5b7ea4;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;PC音声Lane&lt;/b&gt;&lt;br&gt;時計対応・PCM変換&lt;br&gt;16 kHz / mono / PCM16&lt;br&gt;約4秒分をジョブ化" vertex="1"><mxGeometry height="120" width="215" x="265" y="175" as="geometry" /></mxCell><mxCell id="winCommit" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#f1ecf7;strokeColor=#8d77a6;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;T：RawCommitWorker&lt;/b&gt;&lt;br&gt;入力間を交互に処理&lt;br&gt;CAF検証・FlushFileBuffers&lt;br&gt;entry / tipを公開" vertex="1"><mxGeometry height="120" width="240" x="560" y="410" as="geometry" /></mxCell><mxCell id="winMetadata" parent="winHelper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#f1ecf7;strokeColor=#8d77a6;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;T：MetadataWorker&lt;/b&gt;&lt;br&gt;入力状態・level・時計診断&lt;br&gt;manifest・履歴を保存&lt;br&gt;状態は250 ms間隔で生成" vertex="1"><mxGeometry height="120" width="240" x="560" y="565" as="geometry" /></mxCell><mxCell id="w01" edge="1" parent="winHelper" source="prep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="micRead" value="接続を準備"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="w02" edge="1" parent="winHelper" source="prep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="pcRead" value="接続を準備"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="57" /><mxPoint x="680" y="57" /></Array></mxGeometry></mxCell><mxCell id="w06" edge="1" parent="winHelper" source="micRead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="micQueue" value="copy / enqueue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="w07" edge="1" parent="winHelper" source="pcRead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="pcQueue" value="copy / enqueue"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="w08" edge="1" parent="winHelper" source="micQueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="micLane" value="pump"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="372" /><mxPoint x="508" y="372" /><mxPoint x="508" y="509" /><mxPoint x="148" y="509" /></Array></mxGeometry></mxCell><mxCell id="w09" edge="1" parent="winHelper" source="pcQueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="pcLane" value="pump"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="528" y="278" /><mxPoint x="528" y="595" /></Array></mxGeometry></mxCell><mxCell id="w10" edge="1" parent="winHelper" source="winControl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#c28a45;strokeColor=#c28a45;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="prep" value="再取得"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="417" /><mxPoint x="140" y="417" /></Array></mxGeometry></mxCell><mxCell id="w11" edge="1" parent="winHelper" source="micLane" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#8d77a6;strokeColor=#8d77a6;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winCommit" value="immutable job"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="148" y="517" /><mxPoint x="534" y="517" /><mxPoint x="534" y="470" /></Array></mxGeometry></mxCell><mxCell id="w12" edge="1" parent="winHelper" source="pcLane" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#8d77a6;strokeColor=#8d77a6;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winCommit" value="immutable job"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="539" y="595" /><mxPoint x="539" y="470" /></Array></mxGeometry></mxCell><mxCell id="w13" edge="1" parent="winHelper" source="winControl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winMetadata" value="状態・履歴"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="458" /><mxPoint x="550" y="625" /></Array></mxGeometry></mxCell><mxCell id="winRust" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#e9f1fb;strokeColor=#5b7ea4;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;P：mon-desktop&lt;/b&gt;&lt;br&gt;Job Objectで子を所有&lt;br&gt;終了後に正式音声を確定&lt;br&gt;（共通の図1へ）" vertex="1"><mxGeometry height="105" width="240" x="20" y="860" as="geometry" /></mxCell><mxCell id="winFiles" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;fillColor=#f1ecf7;strokeColor=#8d77a6;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;OSファイルシステム上のアプリ管理領域（プロセス外）&lt;/b&gt;&lt;br&gt;分割CAF ＋ 時計・hash・tip / manifest・状態・履歴&lt;br&gt;正常停止：両入力停止確認 → PacketQueue・保存ジョブ排出 → producerClosed。&lt;br&gt;stop.request・マイク選択要求はメイン制御ループが読み取る。" vertex="1"><mxGeometry height="105" width="800" x="300" y="860" as="geometry" /></mxCell><mxCell id="w03" edge="1" parent="1" source="winMicOS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="micRead" value="PCM packet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="245" /><mxPoint x="270" y="298" /><mxPoint x="690" y="298" /></Array></mxGeometry></mxCell><mxCell id="w04" edge="1" parent="1" source="winPlayback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="pcRead" value="PCM / QPC"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="315" /><mxPoint x="960" y="315" /></Array></mxGeometry></mxCell><mxCell id="w05" edge="1" parent="1" source="winChange" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="pcRead" value="通知＋100ms照合"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="700" /><mxPoint x="280" y="323" /><mxPoint x="960" y="323" /></Array></mxGeometry></mxCell><mxCell id="w14" edge="1" parent="1" source="winCommit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#8d77a6;strokeColor=#8d77a6;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winFiles" value="同期して確定"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="570" /><mxPoint x="825" y="808" /><mxPoint x="700" y="808" /></Array></mxGeometry></mxCell><mxCell id="w15" edge="1" parent="1" source="winMetadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winFiles" value="状態公開"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="823" /><mxPoint x="700" y="823" /></Array></mxGeometry></mxCell><mxCell id="w16" edge="1" parent="1" source="winFiles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winControl" value="停止・選択要求"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="808" /><mxPoint x="550" y="808" /></Array></mxGeometry></mxCell><mxCell id="w17" edge="1" parent="1" source="winFiles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#8d77a6;strokeColor=#8d77a6;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="winRust" value="終了後に読取"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="winLegend" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="&lt;b&gt;凡例&lt;/b&gt;　P＝プロセス　T＝実際のstd::thread（メイン以外）　PacketQueue＝メモリ（スレッドではない）　青＝PCM　紫＝保存　破線＝制御" vertex="1"><mxGeometry height="35" width="1080" x="20" y="990" as="geometry" /></mxCell><mxCell id="winNote1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="全体録音：既定・再生中の出力を個別取得し、公平に読み出して250ms待ちで合成。終了する出力の受信済み末尾を排出し、継続中の出力は再起動しない。遅れた時計は基準を補正し全パケットを保持。" vertex="1"><mxGeometry height="42" width="1080" x="20" y="1030" as="geometry" /></mxCell><mxCell id="winNote2" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="マイクの無音パケットも受信扱い。PC音声には3秒未着判定を適用しない。取得・保存待ちの上限は共通契約。上限・不正PCM・保存不能は停止し、確定済み音声を保持。準備ワーカーは終了するまで所有し、遅延完了した古い接続を採用しない。" vertex="1"><mxGeometry height="42" width="1080" x="20" y="1076" as="geometry" /></mxCell><mxCell id="winSources" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;" value="根拠（probes/windows-capture/ 配下）：async_capture.h:14,50 / system_capture.h:17,100 / capture_session.h:36,115,119,220 / input_preparation.h:34,53 / raw_commit_worker.h:25,96 / metadata_worker.h:6,56。5秒テスト・合成試験経路は本図の対象外。" vertex="1"><mxGeometry height="25" width="1080" x="20" y="1122" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
