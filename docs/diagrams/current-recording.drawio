<mxfile host="app.diagrams.net" agent="Codex" type="device" modified="2026-11-17T02:39:46+00:00"><diagram id="recording-runtime-1" name="01 全体・プロセス境界"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1290" background="#ffffff" fold="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;1 / 全体構成：制御と音声を分けて読む&lt;/b&gt;" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=26;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="15" width="1840" height="42" /></mxCell><mxCell id="subtitle" value="上段は操作・状態、下段は音声と保存。P1＝Rust本体、P2＝録音ヘルパー。同じ番号は同じプロセスの再掲。" vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;align=left;verticalAlign=middle;spacing=0;"><mxGeometry as="geometry" x="30" y="65" width="1840" height="40" /></mxCell><mxCell id="app" value="アプリ側｜操作と監視（左 → 右）" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="20" y="120" width="1860" height="490" /></mxCell><mxCell id="web" value="WebView実行領域" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="40" y="175" width="240" height="180" /></mxCell><mxCell id="ui" value="&lt;b&gt;JS UIスレッド&lt;/b&gt;&lt;br&gt;React / TypeScript&lt;br&gt;録音の開始・停止" vertex="1" parent="web" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="116" /></mxCell><mxCell id="main" value="P1：mon-desktop" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="350" y="175" width="240" height="180" /></mxCell><mxCell id="ipc" value="&lt;b&gt;T：blocking pool&lt;/b&gt;&lt;br&gt;要求検証・RecorderController&lt;br&gt;ヘルパーを起動" vertex="1" parent="main" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="116" /></mxCell><mxCell id="request" value="&lt;b&gt;共有ファイル：要求&lt;/b&gt;&lt;br&gt;stop.request&lt;br&gt;microphone-selection.request" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="660" y="225" width="240" height="105" /></mxCell><mxCell id="capture-control" value="P2：録音ヘルパー" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="970" y="175" width="240" height="180" /></mxCell><mxCell id="nativeControl" value="&lt;b&gt;セッション制御 【A】&lt;/b&gt;&lt;br&gt;準備・停止・再取得&lt;br&gt;親終了の検出" vertex="1" parent="capture-control" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="116" /></mxCell><mxCell id="status" value="&lt;b&gt;共有ファイル：状態&lt;/b&gt;&lt;br&gt;manifest / input-status&lt;br&gt;input-levels / 入力履歴" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#F3EDF8;strokeColor=#886DA6;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="1280" y="225" width="240" height="105" /></mxCell><mxCell id="watcher" value="P1：mon-desktop" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="1590" y="175" width="240" height="180" /></mxCell><mxCell id="watch" value="&lt;b&gt;T：監視スレッド 【B】&lt;/b&gt;&lt;br&gt;watch_probe / 200 ms&lt;br&gt;子の終了・入力状態を監視" vertex="1" parent="watcher" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="116" /></mxCell><mxCell id="event-owner" value="P1：mon-desktop" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=2;spacing=10;swimlaneFillColor=#ffffff;"><mxGeometry as="geometry" x="1590" y="395" width="240" height="165" /></mxCell><mxCell id="event" value="&lt;b&gt;T：native main&lt;/b&gt;&lt;br&gt;ウィンドウ・イベント処理" vertex="1" parent="event-owner" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=17;fontColor=#243247;fillColor=#EDF4FC;strokeColor=#52799F;strokeWidth=1.5;spacing=10;"><mxGeometry as="geometry" x="12" y="52" width="216" height="101" /></mxCell><mxCell id="web-repeat" value="同じWebView（再掲）" vertex="1" parent="1" style="swimlane;horizontal=1;startSize=42;collapsible=0;fontStyle=1;