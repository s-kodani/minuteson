=Helvetica;fontSize=14;fontColor=#243247;fillColor=#f1ecf7;strokeColor=#8d77a6;strokeWidth=1.7;spacing=8;" value="&lt;b&gt;OSファイルシステム上のアプリ管理領域（プロセス外）&lt;/b&gt;&lt;br&gt;raw-{lane}-*.caf ＋ 時計・hash・tip / manifest.json / 入力状態・履歴&lt;br&gt;正常停止：両入力のOS停止確認 → 各Qを排出 → producerClosed。&lt;br&gt;同期完了した範囲だけ公開し、未確定の末尾を保存済みと扱わない。" vertex="1"><mxGeometry height="105" width="800" x="300" y="860" as="geometry" /></mxCell><mxCell id="m01" edge="1" parent="1" source="osMic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="micTap" value="PCM・host time"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="326" /><mxPoint x="420" y="326" /></Array></mxGeometry></mxCell><mxCell id="m04" edge="1" parent="1" source="tapControl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWidth=1.7;endArrow=block;endFill=1;dashed=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="osTap" value="OS API"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="334" /><mxPoint x="140" y="334" /></Array></mxGeometry></mxCell><mxCell id="m05" edge="1" parent="1" source="osTap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#5b7ea4;strokeColor=#5b7ea4;strokeWidth=1.7;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;labelPlacement=auto;curved=0;" target="tapIO" value="IO callback"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="352" /><mxPoint x="690" y="352" /><mxPoint x="690" y="368" /></Array></mxGeometry></mxCell><mxCell id="m09" edge="1" parent="1" source="osChange" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#64758b;strokeColor=#64758b;strokeWi