        <mxCell id="w-mic" value="&lt;b&gt;マイク&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;WASAPI取得&lt;br&gt;48kHz・float・1ch&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="20" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w-all" value="&lt;b&gt;PC全体&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;出力別WASAPI loopback&lt;br&gt;48kHz・float・2ch&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="195" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w-app" value="&lt;b&gt;アプリ指定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;process loopback&lt;br&gt;48kHz・float・2ch&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="370" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w-mic-fifo" value="&lt;b&gt;マイク専用FIFO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;取得と停止・解放&lt;br&gt;同じ所有スレッド&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="20" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w-endpoint" value="&lt;b&gt;PC機器間の補正&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;機器別PacketClock&lt;br&gt;EndpointMixer&lt;br&gt;加算・振幅制限&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="195" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w-app-fifo" value="&lt;b&gt;PC入力FIFO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;アプリ指定は&lt;br&gt;機器間Mixerを迂回&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="370" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w-clock" value="&lt;b&gt;入力ごとの時計補正  |  Lane / PacketClock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;QPC異常時：機器位置・サンプル数・到着時刻から推定&lt;br&gt;下限＝自入力の変換末尾 と 共通WAVの混合済み末尾 の最大値&lt;br&gt;パケット全体を配置し直す・元時刻と補正量を記録&lt;/span&gt;" vertex="1" parent="windows" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#eaf3ff;strokeColor=#52799f;">
          <mxGeometry x="20" y="315" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m-mic" value="&lt;b&gt;マイク&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;入力専用AUHAL&lt;br&gt;実デバイスのrate/ch&lt;/span&gt;" vertex="1" parent="macos" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff2e5;strokeColor=#bb854d;">
          <mxGeometry x="20" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-all" value="&lt;b&gt;PC全体&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Core Audio Taps&lt;br&gt;自プロセスを除外&lt;/span&gt;" vertex="1" parent="macos" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff2e5;strokeColor=#bb854d;">
          <mxGeometry x="195" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-app" value="&lt;b&gt;アプリ指定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Core Audio Taps&lt;br&gt;確認済みの&lt;br&gt;プロセスツリー&lt;/span&gt;" vertex="1" parent="macos" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff2e5;strokeColor=#bb854d;">
          <mxGeometry x="370" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-domain" value="&lt;b&gt;時計の橋渡し  |  CaptureClockDomain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;OSのhost時刻 → mach_continuous_time（ns）&lt;br&gt;実形式のPCM・接続世代を確認し、有界FIFOへコピー&lt;/span&gt;" vertex="1" parent="macos" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff2e5;strokeColor=#bb854d;">
          <mxGeometry x="20" y="190" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-align" value="&lt;b&gt;入力ごとの時計補正  |  CapturePCMAlignment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;補正時の下限＝max（直前PCM末尾, 自入力の変換末尾）&lt;br&gt;接続ごとの補正量を保持・全フレームを後方配置&lt;br&gt;元時刻・補正先・推定状態を記録&lt;/span&gt;" vertex="1" parent="macos" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff2e5;strokeColor=#bb854d;">
          <mxGeometry x="20" y="315" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="shared-rust" value="同じRust実装を各OSの録音ヘルパー内で使用  |  mon-capture-ffi → mon-core" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;swimlane;horizontal=1;startSize=38;collapsible=0;fontStyle=1;fillColor=#e7f5eb;strokeColor=#4c8b62;swimlaneFillColor=#ffffff;">
          <mxGeometry x="20" y="555" width="1100" height="285" as="geometry" />
        </mxCell>
        <mxCell id="voice" value="&lt;b&gt;入力ごとに正規化  |  VoiceConverter / mon_voice_*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;各入力のrate/ch → 16kHz・モノラル・PCM16&lt;br&gt;C++ VoicePCM / WavInput と Swift VoicePCM が同じRust変換器を呼ぶ&lt;/span&gt;" vertex="1" parent="shared-rust" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#e7f5eb;strokeColor=#4c8b62;">
          <mxGeometry x="200" y="55" width="700" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mixer" value="&lt;b&gt;共通時刻に配置して統合  |  LiveMixer / mon_wav_mixer_*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;同じ時刻に存在する入力の平均／片入力のみならその音量&lt;br&gt;両方未取得なら無音＋欠損記録／取得した無音PCMは取得済み&lt;br&gt;接続世代・連番・時刻順序を検査し、出力済み音声を保護&lt;/span&gt;" vertex="1" parent="shared-rust" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#e7f5eb;strokeColor=#4c8b62;">
          <mxGeometry x="200" y="180" width="700" height="90" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="保存I/OはOS別実装  |  共通の保存契約・WAV形式・確定記録" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;swimlane;horizontal=1;startSize=38;collapsible=0;fontStyle=1;fillColor=#f2eafa;strokeColor=#8866aa;swimlaneFillColor=#ffffff;">
          <mxGeometry x="20" y="885" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="w-io" value="&lt;b&gt;Windows  |  LiveWav保存ワーカー&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;約4秒のPCM → 書込量確認・FlushFileBuffers&lt;br&gt;SHA-256付き確定記録 → 確定位置公開 → 保存予約解放&lt;/span&gt;" vertex="1" parent="storage" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#f2eafa;strokeColor=#8866aa;">
          <mxGeometry x="20" y="55" width="500" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m-io" value="&lt;b&gt;macOS  |  LiveWavSession + RawSegmentCommitWorker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;約4秒のPCM → 書込み・fsync・読戻し照合&lt;br&gt;SHA-256付き確定記録 → 確定位置公開 → 保存予約解放&lt;/span&gt;" vertex="1" parent="storage" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#f2eafa;strokeColor=#8866aa;">
          <mxGeometry x="580" y="55" width="500" height="85" as="geometry" />
        </mxCell>
        <mxCell id="files" value="&lt;b&gt;単一のrecording.wav ＋ 保存範囲を検証する管理ファイル&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;single-wav-owner.json：ファイル実体の所有情報&lt;br&gt;wav-*.json：連番・範囲・PCMハッシュ／single-wav.json：同期済み末尾&lt;br&gt;共通Rust：WAVヘッダー・確定記録の形式と連続性を検査&lt;/span&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#f2eafa;strokeColor=#8866aa;shape=note;size=20;">
          <mxGeometry x="220" y="1090" width="700" height="105" as="geometry" />
        </mxCell>
        <mxCell id="publish" value="&lt;b&gt;アプリ本体でPCMのSHA-256を照合&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;公開範囲を読取り・チェックポイントと比較&lt;br&gt;終了後に同じWAVを採用・会議へ登録&lt;/span&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#e7f5eb;strokeColor=#4c8b62;">
          <mxGeometry x="400" y="1235" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="reconnect-contract" value="&lt;b&gt;再接続の共通契約（取得・制御の実装はOS別）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;切断した入力の停止・末尾排出・実終了を確認 → 再取得&lt;br&gt;他方の正常入力を維持／古い接続のコールバックは不採用&lt;/span&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff8dd;strokeColor=#baa35b;">
          <mxGeometry x="30" y="1350" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stop-contract" value="&lt;b&gt;停止・障害の共通契約&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;両入力の終了確認＋変換末尾の排出後にWAVを閉じる&lt;br&gt;未確認停止・保存不能：検証できた保存範囲を保持し、成功扱いにしない&lt;/span&gt;" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243247;strokeWidth=1.5;spacing=8;rounded=1;arcSize=10;fillColor=#fff8dd;strokeColor=#baa35b;">
          <mxGeometry x="580" y="1350" width="530" height="80" as="geometry" />
        </mxCell>
