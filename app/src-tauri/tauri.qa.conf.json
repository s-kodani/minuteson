{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MinutesOn QA",
  "identifier": "jp.mon.desktop.qa",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MinutesOn QA — 会議記録",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      },
      {
        "label": "recorder",
        "title": "MinutesOn QA 録音パネル",
        "url": "index.html?window=recorder",
        "width": 227,
        "height": 101,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "recorder-info",
        "title": "MinutesOn QA 録音パネルの説明",
        "url": "index.html?window=recorder-info",
        "width": 360,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "recording-confirmation",
        "title": "MinutesOn QA 録音終了の確認",
        "url": "index.html?window=recording-confirmation",
        "width": 420,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ]
  }
}
