{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mon",
  "version": "0.1.0",
  "identifier": "jp.mon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mon \u2014 \u4f1a\u8b70\u8a18\u9332",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      },
      {
        "label": "recorder",
        "title": "mon \u9332\u97f3\u30d1\u30cd\u30eb",
        "url": "index.html?window=recorder",
        "width": 227,
        "height": 101,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "recorder-info",
        "title": "mon \u9332\u97f3\u30d1\u30cd\u30eb\u306e\u8aac\u660e",
        "url": "index.html?window=recorder-info",
        "width": 360,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "recording-confirmation",
        "title": "mon \u9332\u97f3\u7d42\u4e86\u306e\u78ba\u8a8d",
        "url": "index.html?window=recording-confirmation",
        "width": 420,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": [
        "main",
        "recorder",
        "recorder-info",
        "recording-confirmation"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
